{
  "manifest_version": 3,
  "name": "ApplyVerse",
  "version": "1.4.0",
  "description": "Aggregate developer jobs from 12 job boards and company ATS (Greenhouse, Lever, Ashby) into one de-duplicated, fit-scored list.",
  "permissions": ["scripting", "storage", "activeTab", "tabs", "downloads", "cookies", "alarms", "notifications"],
  "host_permissions": [
    "https://*.ziprecruiter.com/*",
    "https://*.linkedin.com/*",
    "https://*.naukri.com/*",
    "https://*.wellfound.com/*",
    "https://*.cutshort.io/*",
    "https://*.instahyre.com/*",
    "https://*.workatastartup.com/*",
    "https://careers.smartrecruiters.com/*",
    "https://api.smartrecruiters.com/*",
    "https://*.shine.com/*",
    "https://*.indeed.com/*",
    "https://*.glassdoor.co.in/*",
    "https://*.glassdoor.com/*",
    "https://*.foundit.in/*",
    "https://boards-api.greenhouse.io/*",
    "https://boards.greenhouse.io/*",
    "https://api.lever.co/*",
    "https://jobs.lever.co/*",
    "https://api.ashbyhq.com/*",
    "https://jobs.ashbyhq.com/*",
    "https://apply.workable.com/*",
    "https://*.recruitee.com/*",
    "https://*.jobs.personio.com/*",
    "https://www.google.com/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.icims.com/*",
    "https://*.taleo.net/*",
    "https://*.oraclecloud.com/*",
    "https://*.successfactors.com/*",
    "https://*.avature.net/*",
    "https://*.dayforcehcm.com/*",
    "https://*.jobvite.com/*",
    "https://*.teamtailor.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "action": {
    "default_title": "ApplyVerse",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
